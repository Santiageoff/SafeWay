# Copiar a .env y llenar. NUNCA subir .env al repositorio.
#
# OJO: en Vite, todo lo que empiece por VITE_ queda incrustado en el bundle
# que se descarga el navegador. Aqui SOLO puede ir informacion publica.
# La llave secreta de Supabase (sb_secret_...) NO va aqui jamas.

VITE_API_URL=http://localhost:3001

# Supabase, para el inicio de sesion. La llave publicable es publica por
# diseno; lo que protege los datos es RLS, no el secreto de esta llave.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
