# Copiar a .env y llenar.
# Si NO configuras Supabase, la app igual funciona: los reportes se guardan en
# Backend/data/reports.json. Podés desarrollar y hacer la demo sin cuenta.

PORT=3001

# Supabase (opcional). Sacar de: Project Settings > API
SUPABASE_URL=
SUPABASE_KEY=

# Ollama (opcional, para recomendaciones generadas). Requiere ollama corriendo local.
OLLAMA_URL=http://localhost:11434
