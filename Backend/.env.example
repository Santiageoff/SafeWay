# Copiar a .env y llenar. NUNCA subir .env al repositorio.

PORT=3001

# Origenes permitidos por CORS, separados por coma.
# En produccion, poner el dominio real del frontend. Sin esto la API
# solo aceptaria llamadas desde localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Supabase ---
# Project Settings > API
SUPABASE_URL=

# Llave PUBLICABLE (sb_publishable_...). Es publica por diseno: puede ir
# tambien en el frontend. Lo que protege los datos NO es esta llave, es RLS.
SUPABASE_KEY=

# Llave SECRETA (sb_secret_...). Ignora RLS por completo.
# Vive UNICAMENTE aqui, en el backend. Jamas en el frontend ni en el repo.
# Se usa solo para escribir datos oficiales y para los scripts de verificacion.
SUPABASE_SECRET_KEY=
